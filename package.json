{
  "name": "konsepstifin-platform",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:identity": "node --test --test-concurrency=2 tests/identity/*.test.mjs",
    "identity:migrate": "node scripts/identity-admin.mjs migrate",
    "identity:provision": "node scripts/identity-admin.mjs provision",
    "identity:verify": "node scripts/identity-admin.mjs verify",
    "test:unit:node": "node --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:smoke": "node scripts/smoke-release.mjs",
    "test:network": "node --test --test-concurrency=2 tests/network/*.test.mjs",
    "network:import": "node scripts/promoter-admin.mjs import"
  },
  "dependencies": {
    "next": "16.2.10",
    "postgres": "^3.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
