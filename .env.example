DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_MINIMAL_12_KARAKTER
ADMIN_SESSION_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_KARAKTER

STIFIN_API_BASE=https://apro.stifin.id/api
STIFIN_PROMOTER_MODE=national
STIFIN_BRANCH_CODES=KODE-CABANG-1,KODE-CABANG-2
# Alternatif jika STIFIn memberikan endpoint nasional resmi:
# STIFIN_PROMOTER_NATIONAL_PATH=/PATH-ENDPOINT-NASIONAL-RESMI
# Untuk mode satu cabang gunakan STIFIN_PROMOTER_MODE=branch dan:
# STIFIN_BRANCH_CODE=KODE_CABANG_YANG_SAMA_DENGAN_PLUGIN_VOUCHER
STIFIN_PROMOTER_REGION_MAP={"KODE-ID-PROMOTOR":["12.71"]}
STIFIN_API_TIMEOUT_MS=10000
# STIFIN_API_AUTH_HEADER=Authorization
# STIFIN_API_AUTH_VALUE=Bearer TOKEN_RESMI
