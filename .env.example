# Database PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Login portal tim
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-minimal-12-karakter
ADMIN_SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Integrasi promotor opsional
STIFIN_API_BASE=https://apro.stifin.id/api
STIFIN_BRANCH_CODE=
STIFIN_API_TIMEOUT_MS=10000
# Isi hanya jika STIFIn memberikan header/token resmi. Simpan sebagai secret di Coolify.
STIFIN_API_AUTH_HEADER=
STIFIN_API_AUTH_VALUE=
STIFIN_PUBLIC_WHATSAPP=false
STIFIN_PROMOTER_REGION_MAP={}
STIFIN_PROMOTERS_JSON=[]

# Generator konten opsional. Isi salah satu penyedia saja.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Meta Pixel opsional
NEXT_PUBLIC_META_PIXEL_ID=

# Batas unggahan Pustaka, maksimum 100 MB
KNOWLEDGE_MAX_FILE_MB=25
