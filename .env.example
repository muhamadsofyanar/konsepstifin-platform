# Database PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Login portal tim
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-minimal-12-karakter
ADMIN_SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Integrasi promotor opsional
STIFIN_API_BASE=https://apro.stifin.id/api
STIFIN_BRANCH_CODE=
STIFIN_PUBLIC_WHATSAPP=false
STIFIN_PROMOTER_REGION_MAP={}
STIFIN_PROMOTERS_JSON=[]

# Generator konten opsional. Isi salah satu penyedia saja.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Meta Pixel opsional
NEXT_PUBLIC_META_PIXEL_ID=
